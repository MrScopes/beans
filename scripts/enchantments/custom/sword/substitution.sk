on load:
    create sword enchantment named "substitution":
        set enchantment display to "&f<sprite:blocks:block/oak_log> Substitution"
        set enchantment max level to 5
        set enchantment priority to 0
        set enchantment item to oak log

        level values for "cooldown":
            set level 1 to 6 seconds
            set level 2 to 6 seconds
            set level 3 to 6 seconds
            set level 4 to 6 seconds
            set level 5 to 6 seconds

        level values for "window":
            set level 1 to 0.5 seconds
            set level 2 to 0.6 seconds
            set level 3 to 0.7 seconds
            set level 4 to 0.8 seconds
            set level 5 to 1 seconds

        level values for "speed":
            set level 1 to potion effect of speed 1 for 3 seconds
            set level 2 to potion effect of speed 1 for 4 seconds
            set level 3 to potion effect of speed 1 for 5 seconds
            set level 4 to potion effect of speed 1 for 6 seconds
            set level 5 to potion effect of speed 2 for 6 seconds

        level values for "xp cost":
            set level 2 to 60_000
            set level 3 to 200_000
            set level 4 to 750_000
            set level 5 to 1_000_000

        level values for "money cost":
            set level 2 to 100_000
            set level 3 to 300_000
            set level 4 to 900_000
            set level 5 to 1_250_000

local function getDescription(level: integer) :: string:
    set {_window} to "window" of {_level} for "substitution"
    set {_speed} to "speed" of {_level} for "substitution"
    return "&e[RMB] &7parry an attack, resetting cooldown and dashing back. &8(&f%time_format({_window})% &7window&8, &f%effectDisplay({_speed})%&8)"

local function onrightclick(player: player, item: item, level: integer):
    set {-parry::%{_player}%} to now
    set {-parry level::%{_player}%} to {_level}
    play sound "item.armor.equip_iron" with volume 0.6 and pitch 1.3 at {_player}
    
on damage of player with priority high:
    {-parry::%victim%} is set
    set {_window} to "window" of {-parry level::%victim%} for "substitution"

    set {_ping bonus} to min(victim's ping / 2, 200) * 0.001 seconds
    set {_dif} to difference between {-parry::%victim%} and now
    broadcast {_ping bonus}

    if {_dif} <= {_window} + {_ping bonus}:
        cancel event
        parry(victim, {-parry level::%victim%})
        delete {-enchant cooldown::%victim%::substitution}
        delete {-parry::%victim%}
        delete {-parry level::%victim%}

function parry(player: player, level: integer):
    play sound "block.anvil.land" with volume 1 and pitch 1.8 at {_player}

    set {_speed} to "speed" of {_level} for "substitution"
    add {_speed} to {_player}'s potion effects

    spawn block display at {_player}'s head ~ vector(0, 0.5, 0):
        set {_display} to display
        make {_display} not persistent
        set billboard of {_display} to fixed
        set block data of {_display} to oak log
        set transformation translation of {_display} to vector(-0.5, -0.5, -0.5)
        set transformation scale of {_display} to vector(2, 0.75, 2)
        set teleport duration of {_display} to 5 ticks

    draw 10 large smoke particles with offset vector(0.08, 0.1, 0.08) at {_player}'s location
    draw 16 smoke particles with offset vector(0.1, 0.15, 0.1) at {_player}'s location
    draw 10 cloud particles with offset vector(0.4, 0.6, 0.4) at {_player}'s location

    teleport {_display} to {_display} ~ vector(0, -2, 0)

    wait 1 tick

    set {_v} to vector from yaw (yaw of {_player}) and pitch 0
    set {_v} to {_v} * -3

    set y component of {_v} to 0
    set velocity of {_player} to {_v}

    wait 5 ticks
    delete entity within {_display}
