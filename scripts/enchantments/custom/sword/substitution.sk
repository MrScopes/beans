sword enchantment:
    id: "substitution"
    display: "&f<sprite:blocks:block/oak_log> Substitution"
    max level: 5
    priority: 0
    item: oak log
    cost: "normal"

    ability:
        id: "substitution"
        bind: "right click"

        > "cooldown":
            lvl. 1: 6 seconds
            lvl. 2: 6 seconds
            lvl. 3: 6 seconds
            lvl. 4: 6 seconds
            lvl. 5: 6 seconds

        > "window":
            lvl. 1: 0.5 seconds
            lvl. 2: 0.6 seconds
            lvl. 3: 0.7 seconds
            lvl. 4: 0.8 seconds
            lvl. 5: 1 seconds

        > "speed":
            lvl. 1: potion effect of speed 1 for 3 seconds
            lvl. 2: potion effect of speed 1 for 4 seconds
            lvl. 3: potion effect of speed 1 for 5 seconds
            lvl. 4: potion effect of speed 1 for 6 seconds
            lvl. 5: potion effect of speed 2 for 6 seconds

local function getDescription(level: integer) :: string:
    set {_window} to "window" of "substitution" at {_level}
    set {_speed} to "speed" of "substitution" at {_level}
    return "&e[<substitution>] &7parry an attack&8, &7resetting cooldown and dashing back&8. &8(&f%timeFormat({_window})% &7window&8, &f%effectDisplay({_speed})%&8)"

local function substitution(player: player, level: integer):
    set {-parry::%{_player}%} to now
    set {-parry level::%{_player}%} to {_level}
    playEnchantmentSound("combat", "item.armor.equip_iron", 0.6, 1.3, location of {_player}, all players)
    
on damage of player with priority high:
    {-parry::%victim%} is set
    set {_window} to "window" of "substitution" at {-parry level::%victim%}

    set {_ping bonus} to min(victim's ping / 2, 100) * 0.001 seconds
    set {_dif} to difference between {-parry::%victim%} and now

    if {_dif} <= {_window} + {_ping bonus}:
        cancel event
        parry(victim, {-parry level::%victim%})
        delete {-enchant cooldown::%victim%::substitution}
        delete {-parry::%victim%}
        delete {-parry level::%victim%}

function parry(player: player, level: integer):
    playEnchantmentSound("combat", "block.anvil.land", 1, 1.8, location of {_player}, all players)

    set {_speed} to "speed" of "substitution" at {_level}
    add {_speed} to {_player}'s potion effects

    spawn block display at {_player}'s head ~ vector(0, 0.5, 0):
        set {_display} to display
        make {_display} not persistent
        set billboard of {_display} to fixed
        set block data of {_display} to oak log
        set transformation translation of {_display} to vector(-0.5, -0.5, -0.5)
        set transformation scale of {_display} to vector(2, 0.75, 2)
        set teleport duration of {_display} to 5 ticks

    draw 10 large smoke particles with offset vector(0.08, 0.1, 0.08) at {_player}'s location
    draw 16 smoke particles with offset vector(0.1, 0.15, 0.1) at {_player}'s location
    draw 10 cloud particles with offset vector(0.4, 0.6, 0.4) at {_player}'s location

    teleport {_display} to {_display} ~ vector(0, -2, 0)

    wait 1 tick

    set {_v} to vector from yaw (yaw of {_player}) and pitch 0
    set {_v} to {_v} * -3

    set y component of {_v} to 0
    set velocity of {_player} to {_v}

    wait 5 ticks
    delete entity within {_display}
