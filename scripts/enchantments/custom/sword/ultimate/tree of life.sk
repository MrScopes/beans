ultimate sword enchantment:
    id: "tree_of_life"
    display: "&f<sprite:gui:toast/tree> <rainbow><bold>Tree Of Life"
    max level: 5
    priority: 0
    item: oak sapling
    cost: "normal"

    ability:
        id: "tree_of_life"
        bind: "offhand"

        > "radius":
            lvl. 1: 5
            lvl. 2: 5.5
            lvl. 3: 6
            lvl. 4: 6.5
            lvl. 5: 7

        > "duration":
            lvl. 1: 5 seconds
            lvl. 2: 6 seconds
            lvl. 3: 7 seconds
            lvl. 4: 8 seconds
            lvl. 5: 10 seconds

        > "speed":
            lvl. 1: potion effect of speed 1 for 10 seconds
            lvl. 2: potion effect of speed 1 for 11 seconds
            lvl. 3: potion effect of speed 1 for 12 seconds
            lvl. 4: potion effect of speed 1 for 13 seconds
            lvl. 5: potion effect of speed 1 for 15 seconds

        > "regeneration":
            lvl. 1: potion effect of regeneration 1 for 10 seconds
            lvl. 2: potion effect of regeneration 1 for 10 seconds
            lvl. 3: potion effect of regeneration 1 for 10 seconds
            lvl. 4: potion effect of regeneration 1 for 10 seconds
            lvl. 5: potion effect of regeneration 1 for 10 seconds

        > "health boost":
            lvl. 1: potion effect of health boost 1 for 10 seconds
            lvl. 2: potion effect of health boost 1 for 11 seconds
            lvl. 3: potion effect of health boost 1 for 12 seconds
            lvl. 4: potion effect of health boost 1 for 13 seconds
            lvl. 5: potion effect of health boost 1 for 15 seconds

        > "resistance":
            lvl. 1: potion effect of resistance 1 for 10 seconds
            lvl. 2: potion effect of resistance 1 for 10 seconds
            lvl. 3: potion effect of resistance 1 for 10 seconds
            lvl. 4: potion effect of resistance 1 for 10 seconds
            lvl. 5: potion effect of resistance 1 for 10 seconds

        > "strength":
            lvl. 1: potion effect of strength 1 for 10 seconds
            lvl. 2: potion effect of strength 1 for 10 seconds
            lvl. 3: potion effect of strength 1 for 10 seconds
            lvl. 4: potion effect of strength 1 for 10 seconds
            lvl. 5: potion effect of strength 1 for 10 seconds

        > "heal":
            lvl. 1: 0.5
            lvl. 2: 1
            lvl. 3: 1.5
            lvl. 4: 2
            lvl. 5: 2.5

        > "cooldown":
            lvl. 1: 45 seconds
            lvl. 2: 45 seconds
            lvl. 3: 45 seconds
            lvl. 4: 45 seconds
            lvl. 5: 45 seconds

local function getDescription(level: integer) :: string:
    set {_duration} to "duration" of "tree_of_life" at {_level}
    set {_radius} to "radius" of "tree_of_life" at {_level}

    set {_speed} to "speed" of "tree_of_life" at {_level}
    set {_regeneration} to "regeneration" of "tree_of_life" at {_level}
    set {_healthBoost} to "health boost" of "tree_of_life" at {_level}
    set {_resistance} to "resistance" of "tree_of_life" at {_level}
    set {_strength} to "strength" of "tree_of_life" at {_level}
    set {_feed} to "feed" of "tree_of_life" at {_level}
    set {_heal} to "heal" of "tree_of_life" at {_level}

    return "&e[<tree_of_life>] &7buffs allies within &f%{_radius}%m &7for &f%timeFormat({_duration})% &8(&f%effectDisplay({_speed})% %effectDisplay({_regeneration})% %effectDisplay({_healthBoost})% %effectDisplay({_resistance})% %effectDisplay({_strength})%&8, &f%{_heal}%<sprite:gui:hud/heart/full>&8)"

local function tree_of_life(player: player, level: integer) :: boolean:
    add 1 to {-tree of life session::%{_player}%}
    set {_session} to {-tree of life session::%{_player}%}

    if {-tree of life displays::%{_player}%::*} is set:
        delete entities within {-tree of life displays::%{_player}%::*}
        delete {-tree of life displays::%{_player}%::*}

    set {_treeOrigin} to location of {_player}
    set yaw of {_treeOrigin} to 0
    set pitch of {_treeOrigin} to 0

    set {-tree of life displays::%{_player}%::*} to treeOfLifeDisplays({_treeOrigin})

    treeTick({_treeOrigin}, {_player}, {_session}, {_level})

    return true

local function treeTick(origin: location, player: player, session: number, level: integer):
    set {_duration} to "duration" of "tree_of_life" at {_level}
    set {_radius} to "radius" of "tree_of_life" at {_level}

    set {_speed} to "speed" of "tree_of_life" at {_level}
    set {_regeneration} to "regeneration" of "tree_of_life" at {_level}
    set {_healthBoost} to "health boost" of "tree_of_life" at {_level}
    set {_resistance} to "resistance" of "tree_of_life" at {_level}
    set {_strength} to "strength" of "tree_of_life" at {_level}
    set {_feed} to "feed" of "tree_of_life" at {_level}
    set {_heal} to "heal" of "tree_of_life" at {_level}

    set {_circle} to circle of radius {_radius}
    set particle of {_circle} to red dust particle
    set particle density of {_circle} to 1
    
    while {-tree of life session::%{_player}%} is {_session}:
        wait 1 tick
        
        if {-tree of life displays::%{_player}%::1} is not alive:
            stop

        if {-tree of life session::%{_player}%} is not {_session}:
            stop

        set {_canopy} to {_origin}
        add 2.5 to y-coordinate of {_canopy}

        draw shape {_circle} at {_origin}

        loop 6 times:
            set {_particleLoc} to {_canopy}
            add random number between -3 and 3 to x-coordinate of {_particleLoc}
            add random number between -1 and 3.5 to y-coordinate of {_particleLoc}
            add random number between -3 and 3 to z-coordinate of {_particleLoc}
            draw 1 happy villager particle at {_particleLoc}

        chance of 75%:
            loop 3 times:
                set {_leafLoc} to {_canopy}
                add random number between -3.5 and 3.5 to x-coordinate of {_leafLoc}
                add random number between 2 and 5 to y-coordinate of {_leafLoc}
                add random number between -3.5 and 3.5 to z-coordinate of {_leafLoc}
                draw 1 cherry leaves particle at {_leafLoc}

        chance of 20%:
            loop 2 times:
                set {_heartLoc} to {_canopy}
                add random number between -2.5 and 2.5 to x-coordinate of {_heartLoc}
                add random number between -1 and 3 to y-coordinate of {_heartLoc}
                add random number between -2.5 and 2.5 to z-coordinate of {_heartLoc}
                draw 1 heart particle at {_heartLoc}

        if mod(loop-iteration, 15) is 0:
            chance of 40%:
                playEnchantmentSound("combat", "entity.allay.ambient_with_item", 0.8, random number between 0.9 and 1.1, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 40%:
                playEnchantmentSound("combat", "block.azalea_leaves.break", 0.45, random number between 0.8 and 1.2, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 40%:
                playEnchantmentSound("combat", "block.amethyst_cluster.hit", 0.35, random number between 0.8 and 1.1, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 35%:
                playEnchantmentSound("combat", "block.amethyst_block.chime", 0.3, random number between 0.9 and 1.3, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 30%:
                playEnchantmentSound("combat", "block.beacon.ambient", 0.25, random number between 0.8 and 1.0, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 25%:
                playEnchantmentSound("combat", "block.moss.break", 0.4, random number between 0.8 and 1.2, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 20%:
                playEnchantmentSound("combat", "block.grass.step", 0.35, random number between 0.8 and 1.2, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 20%:
                playEnchantmentSound("combat", "entity.experience_orb.pickup", 0.15, random number between 1.8 and 2.0, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 15%:
                playEnchantmentSound("combat", "entity.evoker.prepare_wololo", 0.18, random number between 1.5 and 1.8, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 15%:
                playEnchantmentSound("combat", "block.spore_blossom.break", 0.3, random number between 0.9 and 1.1, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

            chance of 10%:
                playEnchantmentSound("combat", "block.respawn_anchor.charge", 0.15, random number between 1.6 and 1.9, (random element out of {_particleLoc}, {_leafLoc}, {_heartLoc}), all players)

        if time lived of {-tree of life displays::%{_player}%::1} >= {_duration}:
            add 1 to {-tree of life session::%{_player}%}

            delete entities within {-tree of life displays::%{_player}%::*}
            delete {-tree of life displays::%{_player}%::*}

            stop
        
        for {_entity} in all living entities in radius {_radius} around {_origin}:
            if any:
                {_entity} is {_player}
                {clan::%{_entity}%} is {clan::%{_player}%}
                {%{_entity}%::owner} is {_player}
            then:
                if mod(loop-iteration-1, 14) is 0:
                    set {_entity}'s food level to clamp({_entity}'s food level + 1, 0, 10)
                {_affected::%{_entity}%} is not set
                set {_affected::%{_entity}%} to true
                add {_speed} to {_entity}'s potion effects
                add {_regeneration} to {_entity}'s potion effects
                add {_healthBoost} to {_entity}'s potion effects
                add {_resistance} to {_entity}'s potion effects
                add {_strength} to {_entity}'s potion effects
                heal {_entity} by {_heal}
                playEnchantmentSound("combat", "block.beacon.power_select", 1, 1, location of {_entity}, all players)
