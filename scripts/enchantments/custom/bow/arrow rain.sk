on load:
    create bow enchantment named "arrow_rain":
        set enchantment display to "&f<sprite:items:item/spectral_arrow> &6Arrow Rain"
        set enchantment max level to 5
        set enchantment priority to 0
        set enchantment item to spectral arrow

        level values for "cooldown":
            set level 1 to 15 seconds
            set level 2 to 14 seconds
            set level 3 to 13 seconds
            set level 4 to 12 seconds
            set level 5 to 10 seconds

        level values for "threshold":
            set level 1 to 1
            set level 2 to 1
            set level 3 to 1
            set level 4 to 1
            set level 5 to 1

        level values for "amount":
            set level 1 to 10
            set level 2 to 14
            set level 3 to 18
            set level 4 to 20
            set level 5 to 25

        level values for "damage":
            set level 1 to 0.35
            set level 2 to 0.5
            set level 3 to 0.65
            set level 4 to 0.8
            set level 5 to 1.0

        level values for "duration":
            set level 1 to 3 seconds
            set level 2 to 4 seconds
            set level 3 to 5 seconds
            set level 4 to 6 seconds
            set level 5 to 7 seconds

        level values for "dust cost":
            set level 2 to 20
            set level 3 to 100
            set level 4 to 450
            set level 5 to 1_100

        level values for "money cost":
            set level 2 to 25_000
            set level 3 to 150_000
            set level 4 to 500_000
            set level 5 to 1_250_000

local function getDescription(level: integer) :: string:
    set {_amount} to "amount" of "arrow_rain" at {_level}
    set {_damage} to "damage" of "arrow_rain" at {_level}
    set {_duration} to "duration" of "arrow_rain" at {_level}
    return "on land&8, &7rain &f%{_amount}% &7arrows for &f%timeFormat({_duration})% &7dealing &c%{_damage}%&4<sprite:gui:hud/heart/full>&7 each"

local function onHit(shooter: entity, tool: item, projectile: entity, level: integer, force: number, victim: object):
    set {_amount} to "amount" of "arrow_rain" at {_level}
    set {_damage} to "damage" of "arrow_rain" at {_level}
    set {_duration} to "duration" of "arrow_rain" at {_level}

    set {_location} to location of {_projectile} ~ vector(0, 10, 0)
    set yaw of {_location} to 90
    set pitch of {_location} to 90

    loop seconds of {_duration} times:
        loop {_amount} times:
            set {_loc} to {_location} ~ vector(random number between -3 and 3, 0, random number between -3 and 3)
            shoot arrow from {_loc} at speed 0
            set velocity of last shot arrow to vector(0, -0.5, 0)
            set {-%last shot arrow%::damage} to {_damage}
            set {-%last shot arrow%::shooter} to {_shooter}
        wait 1 second

on damage with priority monitor:
    projectile is set
    set {_projectile} to projectile
    set {_damage} to {-%{_projectile}%::damage}
    set {_shooter} to {-%{_projectile}%::shooter}
    cancel event
    set {_source} to a custom damage source:
        set the damage type to arrow
        set the causing entity to {_shooter}
        set the direct entity to {_shooter}
        set the damage location to location of {_projectile}
    damage victim by {_damage} using {_source}
    reset victim's no damage time