on load:
    create bow enchantment named "mark":
        set enchantment display to "&f<sprite:items:item/bone> &dMark"
        set enchantment max level to 5
        set enchantment priority to -1
        set enchantment item to bone

        level values for "cooldown":
            set level 1 to 20 seconds
            set level 2 to 20 seconds
            set level 3 to 20 seconds
            set level 4 to 20 seconds
            set level 5 to 20 seconds

        level values for "multiplier":
            set level 1 to 0.1
            set level 2 to 0.12
            set level 3 to 0.15
            set level 4 to 0.17
            set level 5 to 0.2

        level values for "duration":
            set level 1 to 15 seconds
            set level 2 to 15 seconds
            set level 3 to 15 seconds
            set level 4 to 15 seconds
            set level 5 to 15 seconds

        level values for "xp cost":
            set level 2 to 20_000
            set level 3 to 100_000
            set level 4 to 400_000
            set level 5 to 1_000_000

        level values for "money cost":
            set level 2 to 25_000
            set level 3 to 150_000
            set level 4 to 500_000
            set level 5 to 1_250_000

local function getDescription(level: integer) :: string:
    return "mark the victim, increasing dmg taken by %"multiplier" of {_level} for "mark" * 100%%% for %time_format("duration" of {_level} for "mark")%"

local function onhit(shooter: entity, tool: item, projectile: entity, level: integer, force: number, victim: object):
    if {_victim} is a living entity:
        set {-marked::%{_victim}%} to now
        set {-marked level::%{_victim}%} to {_level}
        set {-marked multiplier::%{_victim}%} to "multiplier" of {_level} for "mark"
        add potion effect of glowing for ("duration" of {_level} for "mark") to {_victim}'s potion effects
        play sound "entity.glow_squid.squirt" with volume 1 and pitch 1 at {_victim}

on damage with priority monitor:
    event isn't canceled
    damage > 0
    {-marked::%victim%} is set
    set {_dif} to difference between now and {-marked::%victim%}
    if {_dif} < "duration" of {-marked level::%victim%} for "mark":
        set damage to damage * (1 + {-marked multiplier::%victim%})
