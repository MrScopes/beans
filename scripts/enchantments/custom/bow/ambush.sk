bow enchantment:
    id: "ambush"
    display: "&f<sprite:items:item/black_dye> &eAmbush"
    max level: 5
    priority: 0
    item: black dye
    cost: "normal"

    > "multiplier":
        lvl. 1: 0.1
        lvl. 2: 0.15
        lvl. 3: 0.2
        lvl. 4: 0.25
        lvl. 5: 0.3

    > "time threshold":
        lvl. 1: 20 seconds
        lvl. 2: 20 seconds
        lvl. 3: 20 seconds
        lvl. 4: 20 seconds
        lvl. 5: 20 seconds

local function getDescription(level: integer) :: string:
    set {_multiplier} to "multiplier" of "ambush" at {_level}
    set {_time} to "time threshold" of "ambush" at {_level}
    return "when the victim hasn't taken damage within &f%timeFormat({_time})%&8, &7increase dmg by &f%{_multiplier} * 100%%%" 

local function onAttack(shooter: entity, victim: entity, projectile: entity, level: integer, force: number, damage: number) :: number:
    set {_time} to "time threshold" of "ambush" at {_level}
    if (difference between now and {-last damaged::%{_victim}%}) > {_time}:
        set {_multiplier} to "multiplier" of "ambush" at {_level}
        playEnchantmentSound("combat", "entity.player.attack.crit", 1, 0.1, location of {_victim}, all players)
        return {_damage} * {_multiplier}

on damage of player with priority monitor:
    event isn't canceled
    damage > 0
    set {-last damaged::%victim%} to now