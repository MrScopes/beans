on load:
    setting("overload", "ultimate", value: true)
    setting("overload", "display", value: "&f<sprite:gui:mob_effect/instant_health> <rainbow><bold>Overload")
    setting("overload", "max", value: 5)
    setting("overload", "priority", value: 1)
    setting("overload", "type", value: "armor")
    setting("overload", "item", value: health potion)

    setting("overload", "health", l1: 2, l2: 4, l3: 6, l4: 8, l5: 10)

    setting("overload", "xp cost", l1: 400_000, l2: 1_500_000, l3: 2_500_000, l4: 4_000_000, l5: 6_000_000)
    setting("overload", "money cost", l1: 500_000, l2: 2_000_000, l3: 3_000_000, l4: 5_000_000, l5: 7_500_000)

local function getDescription(level: integer) :: string:
    set {_health} to get_setting("overload", "health", {_level})
    return "increases max health by &f%{_health}%&f<sprite:gui:hud/heart/full>"
    
local function onapply(armor: item, level: integer, player: player = {_}):
    set {_amount} to get_setting("overload", "health", {_level})
    apply attribute modifier to (item within {_armor}):
        attribute: max health
        id: "skript:overload_enchantment"
        slot: head_slot_group
        amount: {_amount} * 2
        operation: add number

local function onunapply(armor: item, level: integer, player: player = {_}):
    remove attribute modifier with key "skript:overload_enchantment" from item within {_armor}
    