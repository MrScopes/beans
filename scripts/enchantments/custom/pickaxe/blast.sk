on load:
    setting("blast", "display", value: "&f<sprite:blocks:block/tnt_side> &cBlast")
    setting("blast", "max", value: 5)
    setting("blast", "priority", value: 10)
    setting("blast", "type", value: "pickaxe")
    setting("blast", "item", value: tnt)

    setting("blast", "chance", l1: 12, l2: 14, l3: 16, l4: 18, l5: 22)
    setting("blast", "radius", l1: 1.75, l2: 1.85, l3: 2, l4: 2.15, l5: 2.4)

    setting("blast", "xp cost", l2: 35_000, l3: 130_000, l4: 400_000, l5: 800_000)
    setting("blast", "money cost", l2: 50_000, l3: 160_000, l4: 500_000, l5: 900_000)

local function getDescription(level: integer) :: string:
    set {_radius} to get_setting("blast", "radius", {_level})
    return "break blocks within %{_radius}%m"

local function onbreak(player: player, tool: item, level: integer, block: block, block type: item type):
    play sound "minecraft:entity.generic.explode" with volume 0.25 and pitch 1 at location of {_block}
    set {_radius} to get_setting("blast", "radius", {_level})
    fastRadiusClear({_player}, location of {_block}, {_radius})