on load:
    setting("ice", "display", value: "&f<sprite:""minecraft:blocks"":block/ice> &bIce")
    setting("ice", "max level", value: 5)
    setting("ice", "priority", value: 10)
    setting("ice", "type", value: "pickaxe")
    setting("ice", "item", value: packed ice)

    setting("ice", "chance", l1: 1, l2: 1.15, l3: 1.25, l4: 1.35, l5: 1.5)
    setting("ice", "radius", l1: 1.5, l2: 1.65, l3: 1.75, l4: 1.85, l5: 2.2)

    setting("ice", "xp cost", l2: 40_000, l3: 170_000, l4: 500_000, l5: 1_000_000)
    setting("ice", "money cost", l2: 50_000, l3: 250_000, l4: 600_000, l5: 1_200_000)

local function getDescription(level: integer) :: string:
    return "set ice within %get_setting("ice", "radius", {_level})%m"

local function onbreak(player: player, tool: item, level: integer, block: block, block type: item type):
    type of {_block} isn't packed ice or air
    loop all blocks in radius get_setting("ice", "radius", {_level}) around location of {_block}:
        loop-block isn't bedrock, beacon, obsidian, or packed ice
        loop-block is within bound with id "mine"

        set loop-block to packed ice