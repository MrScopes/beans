function populateCosts(enchantment: string):
    set {_max level} to {-ce::%{_enchantment}%::max level}
    {_max level} > 1

    set {_cost tier} to {-ce::%{_enchantment}%::cost}
    set {_ultimate} to {-ce::%{_enchantment}%::ultimate} ? false

    # ========================================================
    # CHEAP
    # ========================================================

    if {_cost tier} is "cheap":

        if {_max level} is 3:
            if {_ultimate} is true:
                set {_money cost::*} to 10_000,  2_000_000,  5_000_000
                set {_dust cost::*}  to 50,      1_000,      10_000
            else:
                set {_money cost::*} to 5_000,   100_000,    500_000
                set {_dust cost::*}  to 25,      500,        5_000

        else if {_max level} is 4:
            if {_ultimate} is true:
                set {_money cost::*} to 10_000,  500_000,  2_000_000,  6_000_000
                set {_dust cost::*}  to 50,      500,      2_500,      15_000
            else:
                set {_money cost::*} to 5_000,   50_000,   200_000,    600_000
                set {_dust cost::*}  to 25,      200,      1_000,      5_000

        else if {_max level} is 5:
            if {_ultimate} is true:
                set {_money cost::*} to 10_000,  250_000,  1_000_000,  3_000_000,  7_500_000
                set {_dust cost::*}  to 50,      250,      1_000,      5_000,      20_000
            else:
                set {_money cost::*} to 5_000,   25_000,   100_000,    250_000,    750_000
                set {_dust cost::*}  to 25,      100,      500,        2_000,      5_000

        else if {_max level} is 10:
            if {_ultimate} is true:
                set {_money cost::*} to 10_000,  25_000,  75_000,  200_000,  500_000,  1_000_000,  2_000_000,  3_500_000,  5_500_000,  8_000_000
                set {_dust cost::*}  to 50,      100,     250,     500,      1_000,    2_000,      4_000,      7_500,      12_500,     20_000
            else:
                set {_money cost::*} to 5_000,   10_000,  25_000,  50_000,   100_000,  175_000,    300_000,    450_000,    600_000,    750_000
                set {_dust cost::*}  to 25,      50,      100,     250,      500,      1_000,      2_000,      3_000,      4_000,      5_000

    # ========================================================
    # NORMAL
    # ========================================================

    else if {_cost tier} is "normal":

        if {_max level} is 3:
            if {_ultimate} is true:
                set {_money cost::*} to 25_000,  3_000_000,  10_000_000
                set {_dust cost::*}  to 100,     2_500,      25_000
            else:
                set {_money cost::*} to 10_000,  250_000,    1_500_000
                set {_dust cost::*}  to 50,      1_000,      7_500

        else if {_max level} is 4:
            if {_ultimate} is true:
                set {_money cost::*} to 25_000,  750_000,  3_000_000,  11_000_000
                set {_dust cost::*}  to 100,     750,      5_000,      30_000
            else:
                set {_money cost::*} to 10_000,  100_000,  500_000,    1_750_000
                set {_dust cost::*}  to 50,      400,      2_000,      7_500

        else if {_max level} is 5:
            if {_ultimate} is true:
                set {_money cost::*} to 25_000,  500_000,  2_000_000,  6_000_000,  12_500_000
                set {_dust cost::*}  to 100,     500,      2_500,      12_500,     40_000
            else:
                set {_money cost::*} to 10_000,  50_000,   250_000,    750_000,    2_000_000
                set {_dust cost::*}  to 50,      200,      1_000,      3_500,      7_500

        else if {_max level} is 10:
            if {_ultimate} is true:
                set {_money cost::*} to 25_000,  50_000,   125_000,  300_000,  750_000,  1_500_000,  3_000_000,  5_500_000,  8_500_000,  13_000_000
                set {_dust cost::*}  to 100,     200,      400,      750,      1_500,    3_000,      6_000,      12_500,     25_000,     40_000
            else:
                set {_money cost::*} to 10_000,  20_000,   50_000,   100_000,  200_000,  400_000,    750_000,    1_200_000,  1_600_000,  2_000_000
                set {_dust cost::*}  to 50,      100,      200,      400,      750,      1_500,      2_500,      4_000,      6_000,      7_500

    # ========================================================
    # EXPENSIVE
    # ========================================================

    else if {_cost tier} is "expensive":

        if {_max level} is 3:
            if {_ultimate} is true:
                set {_money cost::*} to 50_000,  5_000_000,  15_000_000
                set {_dust cost::*}  to 250,     5_000,      50_000
            else:
                set {_money cost::*} to 25_000,  500_000,    3_000_000
                set {_dust cost::*}  to 100,     2_000,      10_000

        else if {_max level} is 4:
            if {_ultimate} is true:
                set {_money cost::*} to 50_000,  1_000_000,  5_000_000,  16_000_000
                set {_dust cost::*}  to 250,     1_500,      8_000,      50_000
            else:
                set {_money cost::*} to 25_000,  200_000,    1_000_000,  3_500_000
                set {_dust cost::*}  to 100,     750,        3_000,      10_000

        else if {_max level} is 5:
            if {_ultimate} is true:
                set {_money cost::*} to 50_000,  750_000,  3_000_000,  8_000_000,  17_500_000
                set {_dust cost::*}  to 250,     1_000,    5_000,      20_000,     60_000
            else:
                set {_money cost::*} to 25_000,  100_000,  500_000,    1_500_000,  4_000_000
                set {_dust cost::*}  to 100,     400,      1_500,      5_000,      10_000

        else if {_max level} is 10:
            if {_ultimate} is true:
                set {_money cost::*} to 50_000,  100_000,  250_000,  500_000,  1_000_000,  2_000_000,  4_000_000,  7_500_000,  12_000_000,  20_000_000
                set {_dust cost::*}  to 250,     400,      750,      1_500,    3_000,      6_000,      12_000,     25_000,     40_000,      60_000
            else:
                set {_money cost::*} to 25_000,  50_000,   100_000,  200_000,  400_000,    750_000,    1_500_000,  2_500_000,  3_500_000,   4_000_000
                set {_dust cost::*}  to 100,     200,      400,      750,      1_500,      2_500,      4_000,      6_000,      8_000,       10_000

    # ========================================================
    # APPLY COSTS
    # ========================================================

    loop {_money cost::*}:
        set {-ce::%{_enchantment}%::money cost::%loop-index%} to loop-value

    loop {_dust cost::*}:
        set {-ce::%{_enchantment}%::dust cost::%loop-index%} to loop-value
        