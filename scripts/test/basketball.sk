function spawnBasketballGoal(loc: location):
    set {_origin} to {_loc}
    add -0.5 to x-coordinate of {_origin}
    add -0.5 to y-coordinate of {_origin}
    add -0.5 to z-coordinate of {_origin}

    # pole
    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to black concrete
        set transformation scale of block display to vector(0.2, 5, 0.1)
        set transformation translation of block display to vector(0, 0, 0)

    # backboard
    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to white concrete
        set transformation scale of block display to vector(3, 2, 0.1)
        set transformation translation of block display to vector(-1.35, 4.25, 0.1)

    # red square / rim pieces
    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to red concrete
        set transformation scale of block display to vector(1, 0.1, 0.1)
        set transformation translation of block display to vector(-0.3798, 4.75, 0.15)

    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to red concrete
        set transformation scale of block display to vector(1, 0.1, 0.1)
        set transformation translation of block display to vector(-0.4, 5.65, 0.15)

    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to red concrete
        set transformation scale of block display to vector(1, 0.1, 0.1)
        set left transformation rotation of block display to quaternion(0.7071068, 0, 0, 0.7071068)
        set transformation translation of block display to vector(-0.3646, 4.7502, 0.15)

    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to red concrete
        set transformation scale of block display to vector(1, 0.1, 0.1)
        set left transformation rotation of block display to quaternion(0.7071068, 0, 0, 0.7071068)
        set transformation translation of block display to vector(0.6457, 4.7502, 0.15)

    # orange rim
    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to orange concrete
        set transformation scale of block display to vector(0.1, 0.1, 0.8)
        set transformation translation of block display to vector(-0.375, 4.54, 0.15)
        set {_displays::backboard} to {_origin} ~ vector(-0.375, 5.54, 0.15)

    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to orange concrete
        set transformation scale of block display to vector(0.1, 0.1, 0.8)
        set transformation translation of block display to vector(0.5, 4.54, 0.15)

    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to orange concrete
        set transformation scale of block display to vector(0.1, 0.1, 0.8)
        set left transformation rotation of block display to quaternion(0.7071068, 0, -0.7071068, 0)
        set transformation translation of block display to vector(0.5, 4.54, 0.15)

    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to orange concrete
        set transformation scale of block display to vector(0.1, 0.1, 0.975)
        set left transformation rotation of block display to quaternion(0.7071068, 0, -0.7071068, 0)
        set transformation translation of block display to vector(0.6, 4.54, 0.9375)

    # net
    spawn block display at {_origin}:
        make block display not persistent
        add block display to {_displays::*}
        set block data of block display to cobweb
        set transformation scale of block display to vector(0.875, 0.875, 0.75)
        set transformation translation of block display to vector(-0.3125, 3.75, 0.25)

    set {_circle} to circle of radius 2
    set particle of {_circle} to blue dust particle

    set {_front} to {_origin}

    set {_yaw} to yaw of {_origin}

    # forward vector from yaw
    set {_x} to 0 - sin({_yaw}) * 1.5
    set {_z} to cos({_yaw}) * 1.5
    
    add 0.5 to y coordinate of {_front}
    add {_x} to x coordinate of {_front}
    add {_z} to z coordinate of {_front}

    set {-test} to true
    while {-test} is set:
        wait 1 tick
        draw shape {_circle} at {_front}
        loop all living entities in radius 2 of {_front}:
            poster({_displays::*}, player "MrScopes", loop-entity, {_front}, {_displays::backboard})
            delete {-test}
            stop loop

function poster(displays: entities, attacker: entity, victim: entity, front: location, backboard: location):
    make {_attacker} invulnerable

    set item cooldown of elytra for {_victim} to 1 second

    teleport {_victim} to {_front}
    push {_victim} upward at speed 0.7

    set {_yaw} to yaw of {_front}

    # forward vector from yaw
    set {_x} to 0 - sin({_yaw}) * 3
    set {_z} to cos({_yaw}) * 3
    add {_x} to x coordinate of {_front}
    add {_z} to z coordinate of {_front}

    teleport {_attacker} to {_front}
    wait 1 tick
    make {_attacker} face block 1 under {_victim}
    push {_attacker} towards {_backboard} at speed 1
    wait 6 ticks

    # slam dunk
    launch flickering trailing burst firework colored orange at {_attacker}
    detonate last launched firework

    reset {_attacker}'s velocity

    reset {_victim}'s velocity
    push {_victim} downward at speed 0.5

    wait 20 ticks
    make {_attacker} vulnerable

    wait 2 seconds
    loop {_displays::*}:
        delete entity within loop-value
    

function spawnBasketballGoalAtPlayer(p: player):
    set {_loc} to location of {_p}

    set {_yaw} to yaw of {_p}

    set {_x} to sin({_yaw}) * 5
    set {_z} to cos({_yaw}) * -5

    add {_x} to x-coordinate of {_loc}
    add {_z} to z-coordinate of {_loc}

    set yaw of {_loc} to {_yaw}
    set pitch of {_loc} to 0

    spawnBasketballGoal({_loc})