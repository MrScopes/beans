function simpleToggleSetting(player: player, item: item type, setting: text, title: text, description: text, enabledByDefault: boolean):
    set {_index} to index of first empty slot of {-settings gui::%{_player}%}

    set {_item} to {_item} named "&f%{_title}%" with all item flags

    if {setting::%{_player}%::%{_setting}%} is set:
        if {_enabledByDefault} is true:
            set {_enabled} to false
        else:
            set {_enabled} to true
    else:
        set {_enabled} to {_enabledByDefault}

    if {_enabled} is true:
        force {_item} to glint
        set lore of {_item} to "&7Click to &cdisable &7%{_description}%."
    else:
        force {_item} to stop glinting
        set lore of {_item} to "&7Click to &aenable &7%{_description}%."

    set {-settings gui::%{_player}%::%{_index}%::type} to "toggle"
    set {-settings gui::%{_player}%::%{_index}%::setting} to {_setting}
    set {-settings gui::%{_player}%::%{_index}%::default} to {_enabledByDefault}

    set slot {_index} of {-settings gui::%{_player}%} to {_item}

function multiOptionSetting(player: player, item: item type, setting: text, title: text, description: text, options: texts):
    set {_index} to index of first empty slot of {-settings gui::%{_player}%}

    set {_item} to {_item} named "&f%{_title}%" with lore "&7%{_description}%" with all item flags
    force {_item} to glint

    set {_selected} to {setting::%{_player}%::%{_setting}%} ? 1st element out of {_options::*}

    add "" to lore of {_item}
    for {_option} in {_options::*}:
        if {_option} is {_selected}:
            add "&8- &a%{_option}%" to lore of {_item}
        else:
            add "&8- &7%{_option}%" to lore of {_item}
    add "" to lore of {_item}

    set {-settings gui::%{_player}%::%{_index}%::type} to "multi"
    set {-settings gui::%{_player}%::%{_index}%::setting} to {_setting}
    set {-settings gui::%{_player}%::%{_index}%::options::*} to {_options::*}

    set slot {_index} of {-settings gui::%{_player}%} to {_item}

command /settings:
    trigger:
        set {-settings gui::%player%} to chest inventory with 1 rows named "Settings"

        multiOptionSetting(player, note block, "mining enchantment sounds", "Mining Enchantment Sounds", "mining enchantment sounds", ("All", "Yours Only", "None"))
        simpleToggleSetting(player, diamond sword, "combat enchantment sounds", "Combat Enchantment Sounds", "combat enchantment sounds", true)
        simpleToggleSetting(player, compass, "chat pinging", "Chat Pinging", "players pinging you in chat", true)
        simpleToggleSetting(player, music disc far, "instant wheel", "Instant Wheel Spin", "instant wheel spin", false)
        multiOptionSetting(player, beacon, "beacon announcements", "Beacon Announcements", "Show other player's beacon rewards", ("All", "Ultra Rare Only", "Ultimate Only", "None"))
        multiOptionSetting(player, ender pearl, "tpa requests", "TPA Requests", "Manage incoming TPA requests", ("All", "Clan Only", "None"))
        multiOptionSetting(player, oak sign, "chat reactions", "Chat Reactions", "Which chat reaction games to see", ("All", "Small Rewards", "Big Rewards", "None"))

        open {-settings gui::%player%} to player

on inventory click:
    player's current inventory is {-settings gui::%player%}
    cancel event
    event-inventory is {-settings gui::%player%}
    set {_type} to {-settings gui::%player%::%index of event-slot%::type}
    set {_setting} to {-settings gui::%player%::%index of event-slot%::setting}
    set {_default} to {-settings gui::%player%::%index of event-slot%::default}
    {_type} is set
    {_setting} is set
    play sound "ui.button.click" with volume 1 and pitch 1 to player
    if {_type} is "toggle":
        if {setting::%player%::%{_setting}%} is set:
            delete {setting::%player%::%{_setting}%}
        else:
            set {setting::%player%::%{_setting}%} to true
    else if {_type} is "multi":
        set {_options::*} to {-settings gui::%player%::%index of event-slot%::options::*}
        set {_current} to {setting::%player%::%{_setting}%} ? 1st element out of {_options::*}

        loop {_options::*}:
            if loop-value is {_current}:
                set {_n} to loop-iteration

        set {_size} to size of {_options::*}
        if {_n} is {_size}:
            set {_nextIndex} to 1
        else:
            set {_nextIndex} to {_n} + 1

        if {_nextIndex} is 1:
            delete {setting::%player%::%{_setting}%}
        else:
            set {_next} to {_nextIndex}th element out of {_options::*}
            set {setting::%player%::%{_setting}%} to {_next}

    player command "/settings"

function playEnchantmentSound(type: text, sound: text, volume: number, pitch: number, at: location, players: players, origin player: player = {_}):
    if {_type} is "mining":
        for {_player} in {_players::*}:
            set {_setting} to {setting::%{_player}%::mining enchantment sounds}

            if {_setting} is "None":
                continue

            if {_setting} is "Yours Only":
                if {_origin player} isn't set:
                    continue
                if {_player} isn't {_origin player}:
                    continue

            play sound {_sound} with volume {_volume} and pitch {_pitch} at {_at} for {_player}

    else if {_type} is "combat":
        for {_player} in {_players::*}:
            if {setting::%{_player}%::combat enchantment sounds} is set:
                continue

            play sound {_sound} with volume {_volume} and pitch {_pitch} at {_at} for {_player}