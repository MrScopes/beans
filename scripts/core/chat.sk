async every 5 minutes:
	chatReaction()

function chatReaction():
	set {_type} to "word" or "sentence"
	if {_type} is "word":
		set {_job} to "type" or "unscramble"
		set {-chat reaction job} to {_job}
		set {_difficulty} to "easy" or "hard"
		if {_difficulty} is "easy":
			set {-chat reaction required} to random element out of {-chat reactions::words::easy::*}
			if {_job} is "type":
				set {-chat reaction reward} to 25_000
			else:
				set {-chat reaction reward} to 35_000
		else:
			set {-chat reaction required} to random element out of {-chat reactions::words::hard::*}
			if {_job} is "type":
				set {-chat reaction reward} to 1 of beaconItem()
			else:
				set {-chat reaction reward} to 2 of beaconItem()
	else:
		set {_job} to "type"
		set {-chat reaction required} to random element out of {-chat reactions::sentences::*}
		set {-chat reaction reward} to 1 of beaconItem()
	
	broadcast "", " &b&lCHAT REACTION!", ""
	if {_job} is "type":
		broadcast "&7Type the following:"
		broadcast "%{-chat reaction required}%"
	else if {_job} is "unscramble":
		broadcast "&7Unscramble the following:"
		broadcast scramble({-chat reaction required})
	broadcast ""
	broadcast "&7Reward:"
	if {-chat reaction reward} is a number:
		broadcast "&b$%kNumber({-chat reaction reward})%&f, &a%kNumber({-chat reaction reward})% XP"
	else:
		set {_name} to text component of name of {-chat reaction reward}
		set {_amount} to "%item amount of {-chat reaction reward}%x " if item amount of {-chat reaction reward} > 1 else ""
		set {_display} to "%{_amount}%%{_name}%"
		broadcast formatted {_display} ? {-chat reaction reward}
	broadcast ""

	set {-chat reaction start} to now

	wait 30 seconds
	if {-chat reaction start} is set:
		broadcast "The chat reaction has expired. Better luck next time!"
		if {_job} is "unscramble":
			broadcast "The correct answer was: &7%{-chat reaction required}%"
		delete {-chat reaction required}
		delete {-chat reaction reward}
		delete {-chat reaction start}
		delete {-chat reaction job}