on load:
	set {-blacklisted words::*} to "nigger", "nigga", "niglet", "fag", "dyke", "tranny", "trannie", "kike", "spic", "wetback", "chink", "gook", "raghead", "towelhead", "coon", "porchmonkey", "beaner", "cracker", "honky", "redskin", "injun", "paki", "cameljockey", "sandnigger", "zipperhead", "heeb", "gypsy", "mongoloid", "autist", "sperg", "windowlicker", "nazi", "hitler", "kkk", "klan"

function leet(input: text) :: text:
	replace all "1" with "i" in {_input}
	replace all "3" with "e" in {_input}
	replace all "4" with "a" in {_input}
	replace all "5" with "s" in {_input}
	replace all "6" with "g" in {_input}
	replace all "7" with "t" in {_input}
	replace all "@" with "a" in {_input}
	replace all "$" with "s" in {_input}
	return {_input}

on async chat:
	set {_rank} to {group::%player%} ? "default"

	if {-chat reaction start} is set:
		if async chat message is "%{-chat reaction required}%":
			if {-chat reaction reward} is a number:
				add {-chat reaction reward} to {money::%player%}
				add {-chat reaction reward} to player's experience
			else:
				give player {-chat reaction reward}
			broadcast formatted "%player_display(player, "[prefix][player]")% &fhas completed the chat reaction in %time_format(difference between now and {-chat reaction start})%!"
			add "%player's uuid%:%difference between now and {-chat reaction start}%" to {chat reaction times::%{-chat reaction required}%::%{-chat reaction job}%::*}
			set {_sorted::*} to {chat reaction times::%{-chat reaction required}%::%{-chat reaction job}%::*}
			sort {_sorted::*} in ascending order
			loop {_sorted::*}:
				set {_split::*} to loop-value split at ":"
				set {_player} to offlineplayer({_split::1})
				set {_time} to {_split::2} parsed as timespan
				if loop-value is "%player's uuid%:%difference between now and {-chat reaction start}%":
					broadcast "&c#&l%loop-iteration% &f%{_player}%&8: &f%{_time}%"
				else:
					broadcast "&b#&l%loop-iteration% &f%{_player}%&8: &f%{_time}%"
				if loop-iteration is 3:
					stop loop
			delete {-chat reaction required}
			delete {-chat reaction reward}
			delete {-chat reaction start}
			delete {-chat reaction job}
			cancel event

	if player doesn't have permission "beans.mod":
		if {-chat muted} is set:
			cancel event
			send "Chat is currently muted: %{-chat muted}%" to player

	event isn't canceled
	if {_rank} is "default":
		set {_dif} to difference between now and {-last message time::%player%}
		if {_dif} < 2 seconds:
			cancel event
			send "&cWait %time_format(2 seconds - {_dif})% before chatting again." to player
		else:
			set {-last message time::%player%} to now

			if {-last message::%player%} is message:
				cancel event
				send "&cDon't repeat the same message." to player
			else:
				set {-last message::%player%} to message

	event isn't canceled
	set {_leet} to leet(message)
	replace all " " with "" in {_leet}
	loop {-blacklisted words::*}:
		if {_leet} contains loop-value:
			send formatted "&d%player% blacklisted word? &f'%loop-value%'&7." to all players where [input has permission "beans.mod"]
			send "&8: &f%message%" to all players where [input has permission "beans.mod"]
			#loop (length of loop-value) times:
			#	add "*" to {_replacement::*}
			#set {_replacement} to join {_replacement::*} with ""
			send "&cYour message contains blacklisted word: '%loop-value%'."
			cancel event
			#replace all {_leet} in message with {_replacement}

	#set {_m::1} to formatted "%player_display(player, "[level] [prefix][player] [trophies] [tag hover] [clan]")%&8: "
	set {_m::1} to formatted "%player_display(player, "[level] [prefix][player] [trophies] [tag hover]")%&8: "
	set {_m::2} to async chat message
	set color format of {_m::2} to group chat color of {_rank}

	if "%{_m::2}%" contains "[item]":
		set {_name} to (name of tool ? "&7%translate component of tool%")
		set {_amount} to text component of "%item amount of tool%x " if item amount of tool > 1 else ""
		set {_component} to merge components ("[", {_amount}, {_name}, "]")
		set hover event of {_component} to hover event showing player's tool
		component replace "[item]" with {_component} in {_m::2}

	loop all players:
		if "%{_m::2}%" contains loop-player's name:
			if {setting::%loop-player%::chat pinging} is set:
				send "&c%loop-player% has pinging disabled." to player
			else:
				set {_component} to text component of "&b@%player_display(loop-player, "[prefix][player]")%"
				component replace loop-player's name with {_component} in {_m::2}

				send formatted "&7You were mentioned by %player_display(player, "[prefix][player]")%&7." to loop-player
				play sound "minecraft:block.note_block.pling" with volume 1 and pitch 2 to loop-player

	set {_format} to merge components {_m::*}
	set async chat format to {_format}

command /chat <text> [<text>]:
	permission: beans.mod
	usage: &c/chat <clear | mute | unmute> [reason]
	trigger:
		if arg 1 is "clear":
			broadcast ""
			loop 250 times:
				send "" to all players where [input doesn't have permission "beans.mod"]
			broadcast formatted " &8&l| &fChat has been cleared by %player_display(player, "[prefix][player]")%."
			if arg 2 is set:
				broadcast formatted " &8&l| &fReason: %arg 2%"
			broadcast ""
		else if arg 1 is "mute":
			set {-chat muted} to arg 2 ? "No Reason Provided"
			broadcast formatted " &8&l| &fChat has been muted by %player_display(player, "[prefix][player]")%."
			if arg 2 is set:
				broadcast formatted " &8&l| &fReason: %arg 2%"
			broadcast ""
		else if arg 1 is "unmute":
			delete {-chat muted}
			broadcast formatted " &8&l| &fChat has been unmuted by %player_display(player, "[prefix][player]")%.&7"

on tab complete of "/chat":
	set tab completions for position 1 to "clear", "mute", "unmute"
	if tab arg 1 is "clear" or "mute":
		set tab completions for position 2 to "<reason>"

